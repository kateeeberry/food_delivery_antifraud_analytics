    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst since = new Date(Date.now() - 7 * 24 * 3600 * 1000).toISOString().slice(0, 10);\nconst MIN_DAYS = 5;                       // для тесту постав 1\n\nconst byKey = {};\nfor (const r of rows) {\n  if (!r.run_date || r.run_date < since) continue;\n  const key = r.rule + '|' + r.entity_id;\n  byKey[key] = byKey[key] || { rule: r.rule, id: r.entity_id, days: new Set() };\n  byKey[key].days.add(r.run_date);\n}\n\nconst lines = [];\nfor (const rule of ['courier', 'ring', 'abuser']) {\n  const all = Object.values(byKey).filter(x => x.rule === rule);\n  const rep = all.filter(x => x.days.size >= MIN_DAYS)\n                 .sort((a, b) => b.days.size - a.days.size);\n  lines.push(`${rule}: ${all.length} unique, ${rep.length} flagged on ${MIN_DAYS}+ days`);\n  rep.slice(0, 5).forEach(x => lines.push(`  ${x.id}: ${x.days.size}/7 days`));\n}\nreturn [{ json: { message: '📅 Weekly antifraud summary\\n' + lines.join('\\n') } }];"
      },
